  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ObjectiveInteractable
  prompt: Hablar
  range: 1.5
  promptOffset: {x: 0, y: 3.8}
  speaker: "Luc\xEDa - Gu\xEDa de Bienestar"
  lines:
  - "\xA1Me contaron de tu exposici\xF3n! Y de c\xF3mo ayudaste a Diego."
  - "Esta fue la semana m\xE1s dura del semestre, y la superaste."
  - "Recuerda: pedir ayuda y ayudar a otros tambi\xE9n es parte de estudiar."
  - "Descansa. Los finales llegan pronto, pero ya sabes c\xF3mo manejar el estr\xE9s."
  stressChange: -15
  stressOnce: 1
  onFinished:
    m_PersistentCalls:
