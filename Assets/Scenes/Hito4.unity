  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StressAwareInteractable
  prompt: Hablar
  range: 1.5
  promptOffset: {x: 0, y: 3.8}
  speaker: Valeria - Estudiante
  lines:
  - "Llevo dos horas aqu\xED repasando. Ya distingo la tibia del peron\xE9... creo."
  - "Suerte en tu exposici\xF3n. Dicen que el Lic. Ram\xEDrez pregunta mucho."
  stressChange: -2
  stressOnce: 1
  onFinished:
    m_PersistentCalls:
      m_Calls: []
  linesAnxious:
  - "\xBFEscuchaste eso? Las luces otra vez..."
  - "Todos dicen que este parcial lo reprueba la mitad del curso. \xBFY si somos
    nosotros?"
