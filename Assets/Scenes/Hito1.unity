  range: 1.5
  promptOffset: {x: 0, y: 3.8}
  speaker: "Diego - Compa\xF1ero"
  lines:
  - "\xA1Volviste! \xBFYa sabes d\xF3nde queda Bienestar Estudiantil?"
  - "(Le cuentas lo que viste en el t\xF3tem: Bienestar est\xE1 en el piso superior.)"
  - "\xA1Gracias! Ya me siento menos perdido. Nos vemos en clases."
  stressChange: -10
  stressOnce: 1
  onFinished:
    m_PersistentCalls:
      m_Calls: []
  objectiveId: companero
  linesPending:
  - "Oye... \xBFt\xFA tambi\xE9n eres nuev@? Estoy perdido."
  - "Me dijeron que busque Bienestar Estudiantil, pero no s\xE9 d\xF3nde queda."
  - "(No sabes. Dicen que el t\xF3tem de la Cafeter\xEDa, pasando el molinete, muestra
    todo el bloque.)"
  stressPending: 3
  linesDone:
  - "\xA1Gracias otra vez! Voy a subir a Bienestar."
